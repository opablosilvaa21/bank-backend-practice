{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn: test",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": "./mvnw.cmd" },
            "args": ["-B", "test"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "mvn: spring-boot:run",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": "./mvnw.cmd" },
            "args": ["spring-boot:run"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "mvn: clean package",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": "./mvnw.cmd" },
            "args": ["-B", "clean", "package"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
